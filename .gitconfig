[core]
  excludesfile = ~/.gitignore
  editor = nvim
  ignorecase = false
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  light = true
  navigate = true
  line-numbers = true
  side-by-side = false
  syntax-theme = GitHub
  minus-style = syntax "#FFEAE8"
  minus-emph-style = bold syntax "#F7C7C2"
  plus-style = syntax "#EBF2DC"
  plus-emph-style = bold syntax "#D5E4B6"
  line-numbers-minus-style = "#AF3029"
  line-numbers-plus-style = "#66800B"
  line-numbers-zero-style = "#B7B5AC"
  file-style = "bold #100F0F"
  file-decoration-style = "#B7B5AC ul"
  hunk-header-style = "syntax bold"
  hunk-header-decoration-style = "#CECDC3 box"

[push]
  default = simple
  autoSetupRemote = true

[pull]
  rebase = true

[rebase]
  autoStash = true
  autoSquash = true

[rerere]
  enabled = true
  autoUpdate = true

[fetch]
  prune = true
  pruneTags = true

[color]
  ui = auto

[alias]
  st = status
  co = checkout
  cob = checkout -b
  br = branch
  ci = commit
  amend = commit --amend --no-edit

  # Push and pull current branch
  ps = "!git push origin $(git rev-parse --abbrev-ref HEAD)"
  pl = "!git pull origin $(git rev-parse --abbrev-ref HEAD)"
  pf = "!git push --force-with-lease origin $(git rev-parse --abbrev-ref HEAD)"

  # Interactive add using fzf
  a = "!f() { \
    changes=$(git status --short); \
    [ -z \"$changes\" ] && echo \"No changes to add.\" && return; \
    echo \"$changes\" | fzf -m | awk '{print $2}' | xargs -r git add; \
  }; f"

  # Side-by-side diff and show with Delta
  ds = -c delta.side-by-side=true diff
  dss = -c delta.side-by-side=true show

  # Visual log graph
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  llog = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

  # Undo helpers
  unstage = restore --staged
  uncommit = reset --soft HEAD~1

  # Maintainer: Checkout any GitHub pull request locally (git pr 123)
  pr = "!f() { \
    remote=$(git remote | grep -E '^upstream$' || echo 'origin'); \
    git fetch $remote pull/$1/head:pr-$1 && git checkout pr-$1; \
  }; f"

  # Contributor: Smart sync fork with upstream default branch (main/master)
  sync = "!f() { \
    target_remote=$(git remote | grep -E '^upstream$' || echo 'origin'); \
    default_branch=$(git remote show $target_remote 2>/dev/null | grep 'HEAD branch' | awk '{print $NF}'); \
    default_branch=${default_branch:-main}; \
    echo \"Syncing with $target_remote/$default_branch...\"; \
    git fetch $target_remote $default_branch && \
    git rebase $target_remote/$default_branch; \
  }; f"

  # Delete local branches that have been merged upstream
  cleanup = "!git branch --merged | grep -v -E '^\\*|main|master|dev|develop' | xargs -r git branch -d"

[merge]
  tool = nvimdiff
  conflictstyle = zdiff3

[mergetool]
  prompt = false
  keepBackup = false

[mergetool "nvimdiff"]
  layout = "LOCAL,BASE,REMOTE / MERGED"
  trustExitCode = true

[diff]
  tool = nvimdiff
  algorithm = histogram
  colorMoved = default

[difftool "nvimdiff"]
  cmd = nvim -d \"$LOCAL\" \"$REMOTE\"

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  required = true
  process = git-lfs filter-process

[log]
  decorate = true
  date = relative

[user]
  email = sheikhlimon404@gmail.com
  name = sheikhlimon
  signingkey = /home/limon/.ssh/id_ed25519

[format]
  signoff = true

[gpg]
  format = ssh

[commit]
  gpgsign = true

[credential]
  helper = store

[init]
  defaultBranch = main

[include]
  path = ~/.gitconfig.local

[index]
  version = 2

[blame]
  ignoreRevsFile = .git-blame-ignore-revs
