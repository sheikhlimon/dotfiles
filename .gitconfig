[core]
  editor = nvim
  pager = delta
  excludesfile = ~/.gitignore
  ignorecase = false

[init]
  defaultBranch = main

[user]
  name = sheikhlimon
  email = sheikhlimon404@gmail.com
  signingkey = /home/limon/.ssh/id_ed25519

[gpg]
  format = ssh

[commit]
  gpgsign = true

[format]
  signoff = true

[credential]
  helper = store

# Workflow Automation
[push]
  default = simple
  autoSetupRemote = true

[pull]
  rebase = true

[rebase]
  autoStash = true
  autoSquash = true

[fetch]
  prune = true
  pruneTags = true

[rerere]
  enabled = true
  autoUpdate = true

# Merge & Conflict Resolution
[merge]
  tool = nvimdiff
  conflictstyle = zdiff3

[mergetool]
  prompt = false
  keepBackup = false

[mergetool "nvimdiff"]
  layout = "LOCAL,BASE,REMOTE / MERGED"
  trustExitCode = true

# Diff settings
[diff]
  tool = nvimdiff
  algorithm = histogram
  colorMoved = default

[difftool "nvimdiff"]
  cmd = nvim -d "$LOCAL" "$REMOTE"

# Delta Pager (Flexoki Light theme)
[interactive]
  diffFilter = delta --color-only

[delta]
  light = true
  navigate = true
  line-numbers = true
  side-by-side = false
  syntax-theme = GitHub
  minus-style = syntax "#FFEAE8"
  minus-emph-style = bold syntax "#F7C7C2"
  plus-style = syntax "#EBF2DC"
  plus-emph-style = bold syntax "#D5E4B6"
  line-numbers-minus-style = "#AF3029"
  line-numbers-plus-style = "#66800B"
  line-numbers-zero-style = "#B7B5AC"
  file-style = "bold #100F0F"
  file-decoration-style = "#B7B5AC ul"
  hunk-header-style = "syntax bold"
  hunk-header-decoration-style = "#CECDC3 box"

# Useful Shortcuts
[alias]
  st = status
  co = checkout
  cob = checkout -b
  br = branch
  ci = commit
  amend = commit --amend --no-edit

  # Push and pull current branch
  ps = "!git push origin $(git rev-parse --abbrev-ref HEAD)"
  pl = "!git pull origin $(git rev-parse --abbrev-ref HEAD)"

  # Safe force-push
  pf = "!git push --force-with-lease origin $(git rev-parse --abbrev-ref HEAD)"

  # Fuzzy select and stage files interactively using FZF
  a = "!f() { \
    changes=$(git status --short); \
    [ -z \"$changes\" ] && echo \"No changes to add.\" && return; \
    echo \"$changes\" | fzf -m | awk '{print $2}' | xargs -r git add; \
  }; f"

  # Split side-by-side diff in terminal via Delta
  ds = -c delta.side-by-side=true diff
  dss = -c delta.side-by-side=true diff --staged
  dshow = -c delta.side-by-side=true show

  # Compact visual commit tree graph
  llog = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

  # Undo the last commit while keeping all changes staged
  uncommit = reset --soft HEAD~1

  # Unstage files without losing modifications
  unstage = restore --staged

  # Checkout any GitHub pull request locally by number (git pr 42)
  pr = "!f() { \
    remote=$(git remote | grep -E '^upstream$' || echo 'origin'); \
    git fetch $remote pull/$1/head:pr-$1 && git checkout pr-$1; \
  }; f"

  # Sync your fork (local and origin) with upstream default branch
  sync = "!f() { \
    target_remote=$(git remote | grep -E '^upstream$' || echo 'origin'); \
    default_branch=$(git symbolic-ref --short refs/remotes/$target_remote/HEAD 2>/dev/null | sed \"s@^$target_remote/@@\"); \
    default_branch=${default_branch:-main}; \
    current_branch=$(git rev-parse --abbrev-ref HEAD); \
    echo \"Fetching from $target_remote/$default_branch...\"; \
    if [ \"$target_remote\" != \"origin\" ]; then \
      if [ \"$current_branch\" = \"$default_branch\" ]; then \
        git fetch $target_remote $default_branch && \
        git rebase $target_remote/$default_branch && \
        echo \"Pushing synced $default_branch to origin...\" && \
        git push origin $default_branch; \
      else \
        git fetch $target_remote $default_branch:$default_branch && \
        echo \"Pushing synced $default_branch to origin...\" && \
        git push origin $default_branch && \
        echo \"Rebasing current branch '$current_branch' onto $default_branch...\" && \
        git rebase $default_branch; \
      fi; \
    else \
      echo \"Pulling latest changes on $current_branch...\"; \
      git pull --rebase origin $current_branch; \
    fi; \
  }; f"

  # Delete local branches merged into main/master (including GitHub squash merges)
  cleanup = "!f() { \
    default_branch=$(git branch --list main master dev develop | head -n 1 | tr -d ' *'); \
    default_branch=${default_branch:-main}; \
    current_branch=$(git rev-parse --abbrev-ref HEAD); \
    if [ \"$current_branch\" != \"$default_branch\" ]; then \
      echo \"Switching to $default_branch...\"; \
      git checkout $default_branch; \
    fi; \
    to_delete=(); \
    for b in $(git for-each-ref --format='%(refname:short)' refs/heads/); do \
      if [[ \"$b\" != \"$default_branch\" && \"$b\" != \"main\" && \"$b\" != \"master\" && \"$b\" != \"dev\" && \"$b\" != \"develop\" ]]; then \
        if [ -z \"$(git cherry $default_branch $b 2>/dev/null | grep -E '^\\+')\" ]; then \
          to_delete+=(\"$b\"); \
        fi; \
      fi; \
    done; \
    if [ ${#to_delete[@]} -gt 0 ]; then \
      echo \"Deleting merged local branches:\"; \
      printf '  - %s\n' \"${to_delete[@]}\"; \
      git branch -D \"${to_delete[@]}\"; \
    else \
      echo \"Everything clean! No merged local branches to delete.\"; \
    fi; \
  }; f"

[include]
  path = ~/.gitconfig.local
