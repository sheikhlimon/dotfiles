#!/usr/bin/env bash
# Universal YADM bootstrap script (Arch Linux, Omarchy & Fedora)
set -euo pipefail

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log() { echo -e "${GREEN}==>${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
error() { echo -e "${RED}✗${NC} $1" >&2; }

detect_os() {
    if [[ -f /etc/os-release ]]; then
        # shellcheck disable=SC1091
        source /etc/os-release
        if [[ "${ID:-}" == "omarchy" || "${ID_LIKE:-}" == *"arch"* || -f /etc/arch-release ]]; then
            echo "arch"
        elif [[ "${ID:-}" == "fedora" || -f /etc/fedora-release ]]; then
            echo "fedora"
        elif [[ "${ID:-}" == "debian" || "${ID_LIKE:-}" == *"debian"* || -f /etc/debian_version ]]; then
            echo "debian"
        else
            echo "${ID:-unknown}"
        fi
    else
        echo "unknown"
    fi
}

OS_TYPE=$(detect_os)
log "Detected OS: ${BLUE}${OS_TYPE}${NC}"

case "$OS_TYPE" in
    arch)
        log "Installing essential Arch/Omarchy packages..."
        arch_pkgs=(
            zsh fzf starship bat eza ripgrep fd zoxide
            neovim kitty git tmux yazi ffmpeg imagemagick
            trash-cli tree duf git-delta jetbrains-mono-fonts
            mpv okular multitail httpie bc gpu-screen-recorder
        )
        sudo pacman -Syu --needed --noconfirm "${arch_pkgs[@]}"

        # AUR & GUI applications
        if command -v yay &>/dev/null; then
            log "Installing AUR and GUI applications..."
            aur_pkgs=(
                ghostty
                ttf-jetbrains-mono-nerd
                visual-studio-code-bin
                mongodb-compass-bin
                foliate
                zen-browser-bin
                telegram-desktop-bin
                bibata-cursor-theme-bin
            )
            yay -S --needed --noconfirm "${aur_pkgs[@]}" || true
        fi
        ;;

    fedora)
        log "Installing essential Fedora packages..."
        fedora_pkgs=(
            zsh fzf starship bat eza ripgrep fd-find zoxide
            neovim kitty git tmux yazi ffmpeg ImageMagick
            trash-cli tree duf git-delta jetbrains-mono-fonts jetbrains-mono-nf-fonts
            mpv multitail httpie bc
        )
        sudo dnf install -y "${fedora_pkgs[@]}"

        # Compatibility symlink for fd on Fedora
        if command -v fd-find &>/dev/null && ! command -v fd &>/dev/null; then
            sudo ln -sf "$(which fd-find)" /usr/local/bin/fd
        fi

        # Enable RPM Fusion for media & codecs
        if ! rpm -q rpmfusion-free-release &>/dev/null; then
            log "Installing RPM Fusion repositories..."
            fedora_ver=$(rpm -E %fedora)
            sudo dnf install -y \
                "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-${fedora_ver}.noarch.rpm" \
                "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-${fedora_ver}.noarch.rpm" || true
        fi

        # Optional Fedora GUI apps (best-effort)
        sudo dnf install -y telegram-desktop gpu-screen-recorder || true
        ;;

    *)
        warn "Unsupported OS for automatic package installation: $OS_TYPE"
        ;;
esac

# Decrypt encrypted files if archive exists
if [ -f "$HOME/.local/share/yadm/archive" ]; then
    log "Encrypted vault detected in YADM repo."
    read -rp "Do you want to decrypt private files now? [Y/n] " answer
    if [[ ! "$answer" =~ ^[Nn]$ ]]; then
        yadm decrypt
    fi
fi

# Set default shell to zsh
if [[ "$SHELL" != *"zsh"* ]] && command -v zsh &>/dev/null; then
    log "Changing default shell to Zsh..."
    chsh -s "$(which zsh)" || true
fi

log "YADM bootstrap complete! 🎉"
